generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../generated/ERD.svg"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Address {
  id         String   @id @default(uuid())
  street     String
  number     String?
  complement String?
  district   String?
  city       String
  state      String
  zipCode    String   @map("zip_code")
  country    String   @default("Brasil")
  createdAt  DateTime @default(now()) @map("created_at")

  church Church?
  sector Sector?
  member Member?

  @@map("addresses")
}

model Church {
  id        String   @id @default(uuid())
  name      String
  addressId String?  @unique @map("address_id")
  address   Address? @relation(fields: [addressId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  sectors Sector[]

  @@map("churches")
}

model Sector {
  id        String  @id @default(uuid())
  name      String
  churchId  String  @map("church_id")
  addressId String? @unique @map("address_id")

  createdAt DateTime @default(now()) @map("created_at")

  church  Church   @relation(fields: [churchId], references: [id])
  address Address? @relation(fields: [addressId], references: [id])

  members Member[]

  @@map("sectors")
}

model Member {
  id        String  @id @default(uuid())
  sectorId  String  @map("sector_id")
  addressId String? @unique @map("address_id")

  name        String
  email       String?
  phone       String?
  position    String?
  birthDate   DateTime? @map("birth_date")
  baptismDate DateTime? @map("baptism_date")

  createdAt DateTime @default(now()) @map("created_at")

  sector  Sector   @relation(fields: [sectorId], references: [id])
  address Address? @relation(fields: [addressId], references: [id])

  @@map("members")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

enum UserRole {
  ADMIN
  LEADER
  MEMBER
}

enum MemberPosition {
  PRESBITERO
  PASTOR
  DIACONO
  LIDER
  MEMBRO
}
